# ChannelPulse OSS — environment configuration
#
# ALL of these are OPTIONAL. The app runs fully local with no configuration:
# bring your own LLM (Ollama / Kimi / any API key) and offline speech-to-text.
#
# They exist for people running their OWN backend: pointing the app at a
# Supabase project you control turns on sign-in, which enables cross-device
# sync and the company question bank. Leave them unset — the default — and the
# app runs in fully offline, no-account mode with nothing gated.

# Your own Supabase project (auth + sync + question bank).
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Optional: base URL for your backend's API. Defaults to the Supabase URL.
VITE_API_BASE_URL=

# NOTE: Never put an LLM/STT provider API key in a VITE_* variable. Those keys
# are entered by the user at runtime in Settings and stored locally on-device.
# The build intentionally fails if a VITE_*_API_KEY is present.
