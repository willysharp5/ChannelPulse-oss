{
  "name": "channelpulse-oss",
  "private": false,
  "version": "1.0.0",
  "description": "ChannelPulse OSS - A private, local-first AI interview copilot: live notes and talking points during calls, powered by your own LLM (Ollama, Kimi, or any API key) and offline speech-to-text. No cloud required.",
  "author": {
    "name": "Edo Williams",
